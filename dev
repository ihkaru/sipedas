#!/bin/bash

# SIKENDIS Smart Dev Wrapper v2.1 (Cross-Platform: Windows & Linux/CachyOS)
# Fully Docker-based — tidak memerlukan Node.js, PHP, atau tool apapun di host.
# Semua service (PHP/Octane, Vite HMR, MySQL, Redis, phpMyAdmin) berjalan di Docker.

PROJECT_NAME="sikendis"
APP_PORT=8200
DB_PORT=3309
PMA_PORT=8281
VITE_PORT=5173

# Color coding
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

# Deteksi CLI Docker Compose (v2 plugin vs v1 standalone)
if docker compose version >/dev/null 2>&1; then
    DC="docker compose"
else
    DC="docker-compose"
fi

function get_hash() {
    cat composer.json package.json dockerfile docker/caddy/Caddyfile docker-compose.dev.yml vite.config.js 2>/dev/null | md5sum | cut -d' ' -f1
}

function build_needed() {
    if [ ! -f .build_hash ]; then return 0; fi
    local old_hash=$(cat .build_hash)
    local new_hash=$(get_hash)
    if [ "$old_hash" != "$new_hash" ]; then return 0; fi
    return 1
}

case "$1" in
    up)
        BUILD_FLAG=""
        if build_needed; then
            echo -e "${YELLOW}Detected changes in dependencies or Dockerfile. Rebuilding...${NC}"
            BUILD_FLAG="--build"
        fi

        echo -e "${GREEN}${BOLD}Starting SIKENDIS dev stack (fully Docker)...${NC}"
        $DC -f docker-compose.dev.yml up $BUILD_FLAG --remove-orphans -d

        echo -n "Menunggu MySQL siap"
        for i in $(seq 1 20); do
            STATUS=$(docker inspect --format "{{.State.Health.Status}}" sikendis-db 2>/dev/null)
            if [ "$STATUS" = "healthy" ]; then
                echo " ✓"
                break
            fi
            echo -n "."
            sleep 1
        done

        # Pastikan app container berjalan
        APP_STATUS=$(docker inspect --format "{{.State.Status}}" sikendis-app-run 2>/dev/null)
        if [ "$APP_STATUS" != "running" ]; then
            echo -e "${YELLOW}Memastikan container app aktif...${NC}"
            docker start sikendis-app-run 2>/dev/null || true
        fi

        get_hash > .build_hash

        echo ""
        echo -e "${GREEN}${BOLD}╔══════════════════════════════════════════╗${NC}"
        echo -e "${GREEN}${BOLD}║   SIKENDIS Dev Stack Running             ║${NC}"
        echo -e "${GREEN}${BOLD}╠══════════════════════════════════════════╣${NC}"
        echo -e "${GREEN}${BOLD}║  App  → http://localhost:$APP_PORT          ║${NC}"
        echo -e "${GREEN}${BOLD}║  PMA  → http://localhost:$PMA_PORT          ║${NC}"
        echo -e "${GREEN}${BOLD}║  Vite → http://localhost:$VITE_PORT (HMR)   ║${NC}"
        echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}Tip: bash dev vite-logs${NC} untuk melihat log Vite HMR"
        ;;

    down)
        echo -e "${YELLOW}Stopping all services...${NC}"
        $DC -f docker-compose.dev.yml down
        echo -e "${GREEN}All services stopped.${NC}"
        ;;

    logs)
        $DC -f docker-compose.dev.yml logs -f app
        ;;

    vite-logs)
        echo -e "${GREEN}=== Vite HMR Log (Ctrl+C untuk berhenti) ===${NC}"
        $DC -f docker-compose.dev.yml logs -f vite
        ;;

    shell)
        $DC -f docker-compose.dev.yml exec app sh
        ;;

    artisan)
        shift
        $DC -f docker-compose.dev.yml exec app php artisan "$@"
        ;;

    composer)
        shift
        $DC -f docker-compose.dev.yml exec app composer "$@"
        ;;

    npm)
        shift
        $DC -f docker-compose.dev.yml exec vite npm "$@"
        ;;

    reset)
        echo -e "${RED}${BOLD}WARNING: This will wipe your database! Continue? (y/n)${NC}"
        read -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            $DC -f docker-compose.dev.yml exec app php artisan migrate:fresh --seed
        fi
        ;;

    fix)
        echo "Fixing permissions and clearing ALL caches (views, routes, config, icons)..."
        $DC -f docker-compose.dev.yml exec app chown -R www-data:www-data storage bootstrap/cache 2>/dev/null || true
        $DC -f docker-compose.dev.yml exec app chmod -R 775 storage bootstrap/cache 2>/dev/null || true
        $DC -f docker-compose.dev.yml exec app php artisan optimize:clear
        $DC -f docker-compose.dev.yml exec app php artisan view:clear
        $DC -f docker-compose.dev.yml exec app php artisan icons:cache
        $DC -f docker-compose.dev.yml exec app php artisan octane:reload
        echo -e "${GREEN}All caches cleared and workers reloaded!${NC}"
        ;;

    reload)
        echo "Reloading Octane workers (apply PHP/Blade changes)..."
        $DC -f docker-compose.dev.yml exec app php artisan octane:reload
        echo -e "${GREEN}Workers reloaded!${NC}"
        ;;

    clear)
        echo "Clearing all framework caches (views, routes, config)..."
        $DC -f docker-compose.dev.yml exec app php artisan optimize:clear
        $DC -f docker-compose.dev.yml exec app php artisan view:clear
        echo -e "${GREEN}Caches cleared!${NC}"
        ;;

    ps)
        $DC -f docker-compose.dev.yml ps
        ;;

    *)
        echo -e "${BOLD}SIKENDIS Dev Wrapper v2.1${NC} — Fully Docker (Cross-Platform)"
        echo ""
        echo -e "Usage: ${BOLD}bash dev <command>${NC}"
        echo ""
        echo -e "  ${GREEN}up${NC}          - Start ALL services (App + Vite + DB + Redis + PMA)"
        echo -e "  ${GREEN}down${NC}        - Stop ALL services"
        echo -e "  ${GREEN}ps${NC}          - Status semua container"
        echo -e "  ${GREEN}logs${NC}        - Tail log container app (PHP/Octane)"
        echo -e "  ${GREEN}vite-logs${NC}   - Tail log container Vite (CSS/JS HMR)"
        echo -e "  ${GREEN}shell${NC}       - Buka shell di dalam container app"
        echo -e "  ${GREEN}artisan ...${NC} - Jalankan php artisan di container (cth: bash dev artisan migrate)"
        echo -e "  ${GREEN}composer ...${NC}- Jalankan composer di container (cth: bash dev composer require foo)"
        echo -e "  ${GREEN}npm ...${NC}     - Jalankan npm di container (cth: bash dev npm install)"
        echo -e "  ${GREEN}reload${NC}      - Reload Octane workers (apply perubahan PHP)"
        echo -e "  ${GREEN}clear${NC}       - Hapus cache framework (views, routes, config)"
        echo -e "  ${GREEN}fix${NC}         - Fix permissions + hapus semua cache + reload"
        echo -e "  ${GREEN}reset${NC}       - ⚠️  Wipe DB + migrate fresh + seed ulang"
        exit 1
        ;;
esac
